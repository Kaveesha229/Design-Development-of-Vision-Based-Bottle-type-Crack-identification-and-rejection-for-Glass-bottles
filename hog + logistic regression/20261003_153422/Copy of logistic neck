{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"10UWGTQDw4y2qMHLb54-GTe0URYlGRWGi","timestamp":1791041116030}],"gpuType":"T4","authorship_tag":"ABX9TyMuofZI+7Q42IkgmKPTYPT4"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"},"accelerator":"GPU"},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"id":"j5rsJn53Xm0i","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1791041661529,"user_tz":-330,"elapsed":15533,"user":{"displayName":"Kaveesha Gunawardena","userId":"06440496172812552380"}},"outputId":"3fac8770-73da-40e8-fb43-7654cdc365f1"},"outputs":[{"output_type":"stream","name":"stdout","text":["Installation completed.\n","Select Runtime → Restart session.\n","After restarting, run Cell 2 directly.\n"]}],"source":["import sys\n","import subprocess\n","\n","subprocess.check_call([\n","    sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n","    \"scikit-learn\", \"scikit-image\", \"Pillow\",\n","    \"pandas\", \"joblib\", \"reportlab\"\n","])\n","\n","# Use one consistent Matplotlib version to avoid the previous error.\n","subprocess.check_call([\n","    sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n","    \"--no-cache-dir\", \"--force-reinstall\", \"--no-deps\",\n","    \"matplotlib==3.10.0\"\n","])\n","\n","print(\"Installation completed.\")\n","print(\"Select Runtime → Restart session.\")\n","print(\"After restarting, run Cell 2 directly.\")"]},{"cell_type":"code","source":["# ============================================================\n","# HOG + LOGISTIC REGRESSION — GOOGLE COLAB\n","# Labels: good = 0, crack = 1\n","# Uses existing train / valid / test folders.\n","# ============================================================\n","\n","from pathlib import Path\n","from datetime import datetime\n","import hashlib\n","import json\n","import platform\n","import time\n","import warnings\n","from xml.sax.saxutils import escape\n","\n","import numpy as np\n","import pandas as pd\n","import joblib\n","import sklearn\n","import skimage\n","\n","from PIL import Image, ImageOps\n","from skimage.feature import hog\n","\n","import matplotlib\n","matplotlib.use(\"Agg\")\n","import matplotlib.pyplot as plt\n","\n","from sklearn.pipeline import Pipeline\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.exceptions import ConvergenceWarning\n","from sklearn.metrics import (\n","    accuracy_score,\n","    balanced_accuracy_score,\n","    precision_score,\n","    recall_score,\n","    f1_score,\n","    confusion_matrix,\n","    classification_report,\n","    roc_auc_score,\n","    average_precision_score,\n","    roc_curve,\n","    precision_recall_curve,\n","    log_loss\n",")\n","\n","from reportlab.lib import colors\n","from reportlab.lib.styles import getSampleStyleSheet\n","from reportlab.lib.units import inch\n","from reportlab.platypus import (\n","    SimpleDocTemplate,\n","    Paragraph,\n","    Spacer,\n","    Table,\n","    TableStyle,\n","    Image as PDFImage,\n","    PageBreak\n",")\n","\n","from google.colab import drive, files\n","\n","# ============================================================\n","# 1. SETTINGS\n","# ============================================================\n","\n","DATASET_ROOT = Path(\"/content/drive/MyDrive/bottlecrackml\")\n","OUTPUT_ROOT = DATASET_ROOT / \"hog + logistic regression\"\n","\n","RUN_NAME = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","RUN_DIR = OUTPUT_ROOT / RUN_NAME\n","PLOTS_DIR = RUN_DIR / \"graphs\"\n","\n","CLASS_LABELS = {\"good\": 0, \"crack\": 1}\n","CLASS_NAMES = [\"good\", \"crack\"]\n","\n","# Keep these HOG settings identical for your later HOG models.\n","IMAGE_SIZE = (128, 128)  # width, height\n","\n","HOG_SETTINGS = {\n","    \"orientations\": 9,\n","    \"pixels_per_cell\": (8, 8),\n","    \"cells_per_block\": (2, 2),\n","    \"block_norm\": \"L2-Hys\",\n","    \"transform_sqrt\": True,\n","    \"feature_vector\": True\n","}\n","\n","RANDOM_SEED = 42\n","MAX_ITERATIONS = 3000\n","\n","# Regularization and class weighting are selected using VALID only.\n","C_VALUES = [0.01, 0.1, 1.0, 10.0]\n","CLASS_WEIGHTS = [None, \"balanced\"]\n","\n","# Choose a decision threshold using validation F1.\n","THRESHOLDS = np.linspace(0.10, 0.90, 81)\n","\n","EXTENSIONS = {\n","    \".jpg\", \".jpeg\", \".png\", \".bmp\", \".tif\", \".tiff\", \".webp\"\n","}\n","\n","# ============================================================\n","# 2. MOUNT DRIVE AND CHECK FOLDERS\n","# ============================================================\n","\n","if not Path(\"/content/drive/MyDrive\").exists():\n","    drive.mount(\"/content/drive\")\n","\n","for split in [\"train\", \"valid\", \"test\"]:\n","    for class_name in CLASS_LABELS:\n","        folder = DATASET_ROOT / split / class_name\n","        if not folder.is_dir():\n","            raise FileNotFoundError(\n","                f\"Required folder missing:\\n{folder}\"\n","            )\n","\n","PLOTS_DIR.mkdir(parents=True, exist_ok=True)\n","\n","print(\"Dataset:\", DATASET_ROOT)\n","print(\"Outputs:\", RUN_DIR)\n","print(\"This model uses CPU; a GPU is not required.\")\n","\n","# ============================================================\n","# 3. PREPROCESSING AND HOG FEATURES\n","# ============================================================\n","\n","def preprocess_image(path):\n","    with Image.open(path) as opened:\n","        image = ImageOps.exif_transpose(opened).convert(\"L\")\n","        image = image.resize(\n","            IMAGE_SIZE,\n","            Image.Resampling.LANCZOS\n","        )\n","        return np.asarray(image, dtype=np.float32) / 255.0\n","\n","\n","def extract_features(path):\n","    return hog(\n","        preprocess_image(path),\n","        **HOG_SETTINGS\n","    ).astype(np.float32)\n","\n","\n","def content_hash(path):\n","    # Detect identical image pixels even when filenames differ.\n","    with Image.open(path) as opened:\n","        image = ImageOps.exif_transpose(opened).convert(\"RGB\")\n","        hasher = hashlib.sha256()\n","        hasher.update(str(image.size).encode())\n","        hasher.update(image.tobytes())\n","        return hasher.hexdigest()\n","\n","\n","dataset = {}\n","manifest = []\n","seen_hashes = {}\n","\n","for split in [\"train\", \"valid\", \"test\"]:\n","    feature_rows = []\n","    labels = []\n","    paths = []\n","\n","    for class_name, label in CLASS_LABELS.items():\n","        folder = DATASET_ROOT / split / class_name\n","        image_paths = sorted(\n","            p for p in folder.rglob(\"*\")\n","            if p.is_file()\n","            and p.suffix.lower() in EXTENSIONS\n","        )\n","\n","        if not image_paths:\n","            raise ValueError(\n","                f\"No images found in:\\n{folder}\"\n","            )\n","\n","        print(\n","            f\"Loading {split}/{class_name}: \"\n","            f\"{len(image_paths)} images\"\n","        )\n","\n","        for path in image_paths:\n","            try:\n","                digest = content_hash(path)\n","\n","                if digest in seen_hashes:\n","                    previous = seen_hashes[digest]\n","\n","                    if previous[\"label\"] != label:\n","                        raise ValueError(\n","                            \"Identical image has conflicting labels:\\n\"\n","                            f\"{previous['path']}\\n{path}\"\n","                        )\n","\n","                    if previous[\"split\"] != split:\n","                        raise ValueError(\n","                            \"Identical image found across dataset splits:\\n\"\n","                            f\"{previous['path']}\\n{path}\\n\"\n","                            \"Remove this leakage before training.\"\n","                        )\n","                else:\n","                    seen_hashes[digest] = {\n","                        \"split\": split,\n","                        \"label\": label,\n","                        \"path\": str(path)\n","                    }\n","\n","                features = extract_features(path)\n","\n","            except Exception as error:\n","                raise RuntimeError(\n","                    f\"Could not process:\\n{path}\\n{error}\"\n","                ) from error\n","\n","            feature_rows.append(features)\n","            labels.append(label)\n","            paths.append(str(path))\n","\n","            manifest.append({\n","                \"split\": split,\n","                \"class\": class_name,\n","                \"label\": label,\n","                \"path\": str(path),\n","                \"sha256\": digest\n","            })\n","\n","    dataset[split] = {\n","        \"X\": np.stack(feature_rows),\n","        \"y\": np.asarray(labels, dtype=np.int64),\n","        \"paths\": paths\n","    }\n","\n","manifest_df = pd.DataFrame(manifest)\n","manifest_df.to_csv(\n","    RUN_DIR / \"dataset_manifest.csv\",\n","    index=False\n",")\n","\n","counts = pd.crosstab(\n","    manifest_df[\"split\"],\n","    manifest_df[\"class\"]\n",").reindex([\"train\", \"valid\", \"test\"])\n","\n","print(\"\\nDataset counts:\")\n","print(counts)\n","print(\n","    \"\\nHOG features per image:\",\n","    dataset[\"train\"][\"X\"].shape[1]\n",")\n","\n","# Save exactly the features used in this experiment.\n","np.savez_compressed(\n","    RUN_DIR / \"hog_features.npz\",\n","    X_train=dataset[\"train\"][\"X\"],\n","    y_train=dataset[\"train\"][\"y\"],\n","    X_valid=dataset[\"valid\"][\"X\"],\n","    y_valid=dataset[\"valid\"][\"y\"],\n","    X_test=dataset[\"test\"][\"X\"],\n","    y_test=dataset[\"test\"][\"y\"]\n",")\n","\n","X_train = dataset[\"train\"][\"X\"]\n","y_train = dataset[\"train\"][\"y\"]\n","X_valid = dataset[\"valid\"][\"X\"]\n","y_valid = dataset[\"valid\"][\"y\"]\n","\n","# ============================================================\n","# 4. TRAIN AND SELECT SETTINGS USING VALIDATION ONLY\n","# ============================================================\n","\n","search_rows = []\n","best_model = None\n","best_key = None\n","best_threshold = None\n","best_settings = None\n","\n","search_start = time.perf_counter()\n","\n","for c_value in C_VALUES:\n","    for class_weight in CLASS_WEIGHTS:\n","        model = Pipeline([\n","            (\"scaler\", StandardScaler()),\n","            (\"classifier\", LogisticRegression(\n","                C=c_value,\n","                class_weight=class_weight,\n","                solver=\"lbfgs\",\n","                max_iter=MAX_ITERATIONS,\n","                random_state=RANDOM_SEED\n","            ))\n","        ])\n","\n","        start = time.perf_counter()\n","\n","        with warnings.catch_warnings(record=True) as captured:\n","            warnings.simplefilter(\"always\", ConvergenceWarning)\n","            model.fit(X_train, y_train)\n","\n","        fit_seconds = time.perf_counter() - start\n","        converged = not any(\n","            issubclass(w.category, ConvergenceWarning)\n","            for w in captured\n","        )\n","\n","        crack_column = list(model.classes_).index(1)\n","        valid_scores = model.predict_proba(\n","            X_valid\n","        )[:, crack_column]\n","\n","        threshold_rows = []\n","        for threshold in THRESHOLDS:\n","            predicted = (\n","                valid_scores >= threshold\n","            ).astype(int)\n","\n","            threshold_rows.append({\n","                \"threshold\": float(threshold),\n","                \"f1\": f1_score(\n","                    y_valid, predicted, zero_division=0\n","                ),\n","                \"recall\": recall_score(\n","                    y_valid, predicted, zero_division=0\n","                ),\n","                \"precision\": precision_score(\n","                    y_valid, predicted, zero_division=0\n","                )\n","            })\n","\n","        # Tie breaking: higher recall, then precision,\n","        # then threshold closest to 0.5.\n","        selected = max(\n","            threshold_rows,\n","            key=lambda row: (\n","                row[\"f1\"],\n","                row[\"recall\"],\n","                row[\"precision\"],\n","                -abs(row[\"threshold\"] - 0.5)\n","            )\n","        )\n","\n","        search_rows.append({\n","            \"C\": c_value,\n","            \"class_weight\": str(class_weight),\n","            \"threshold\": selected[\"threshold\"],\n","            \"valid_f1\": selected[\"f1\"],\n","            \"valid_recall\": selected[\"recall\"],\n","            \"valid_precision\": selected[\"precision\"],\n","            \"fit_seconds\": fit_seconds,\n","            \"converged\": converged\n","        })\n","\n","        print(\n","            f\"C={c_value}, weight={class_weight}, \"\n","            f\"validation F1={selected['f1']:.4f}, \"\n","            f\"converged={converged}\"\n","        )\n","\n","        if not converged:\n","            continue\n","\n","        key = (\n","            selected[\"f1\"],\n","            selected[\"recall\"],\n","            selected[\"precision\"]\n","        )\n","\n","        if best_key is None or key > best_key:\n","            best_key = key\n","            best_model = model\n","            best_threshold = selected[\"threshold\"]\n","            best_settings = {\n","                \"C\": c_value,\n","                \"class_weight\": class_weight\n","            }\n","\n","search_seconds = time.perf_counter() - search_start\n","search_df = pd.DataFrame(search_rows)\n","search_df.to_csv(\n","    RUN_DIR / \"validation_search.csv\",\n","    index=False\n",")\n","\n","if best_model is None:\n","    raise RuntimeError(\n","        \"No candidate converged. Increase MAX_ITERATIONS \"\n","        \"and rerun the training cell.\"\n","    )\n","\n","print(\"\\nSelected settings:\", best_settings)\n","print(\"Selected threshold:\", best_threshold)\n","\n","# Keep the model fitted on TRAIN only.\n","# Do not refit after selecting the validation threshold.\n","MODEL_PATH = RUN_DIR / \"hog_logistic_regression.joblib\"\n","\n","configuration = {\n","    \"class_labels\": CLASS_LABELS,\n","    \"image_size\": IMAGE_SIZE,\n","    \"hog_settings\": HOG_SETTINGS,\n","    \"preprocessing\": (\n","        \"EXIF orientation correction, grayscale, \"\n","        \"Lanczos resize to 128x128, float pixels divided by 255\"\n","    ),\n","    \"threshold\": best_threshold,\n","    \"selected_settings\": best_settings,\n","    \"random_seed\": RANDOM_SEED,\n","    \"sklearn_version\": sklearn.__version__,\n","    \"skimage_version\": skimage.__version__\n","}\n","\n","joblib.dump({\n","    \"pipeline\": best_model,\n","    \"configuration\": configuration\n","}, MODEL_PATH)\n","\n","with open(RUN_DIR / \"configuration.json\", \"w\") as f:\n","    json.dump(configuration, f, indent=2)\n","\n","# ============================================================\n","# 5. FINAL EVALUATION\n","# ============================================================\n","\n","def evaluate(y_true, scores, threshold):\n","    predicted = (scores >= threshold).astype(int)\n","    tn, fp, fn, tp = confusion_matrix(\n","        y_true, predicted, labels=[0, 1]\n","    ).ravel()\n","\n","    return {\n","        \"Accuracy\": accuracy_score(y_true, predicted),\n","        \"Balanced accuracy\": balanced_accuracy_score(\n","            y_true, predicted\n","        ),\n","        \"Crack precision\": precision_score(\n","            y_true, predicted, zero_division=0\n","        ),\n","        \"Crack recall\": recall_score(\n","            y_true, predicted, zero_division=0\n","        ),\n","        \"Crack F1\": f1_score(\n","            y_true, predicted, zero_division=0\n","        ),\n","        \"Specificity\": tn / (tn + fp),\n","        \"ROC AUC\": roc_auc_score(y_true, scores),\n","        \"Average precision (AP)\": average_precision_score(\n","            y_true, scores\n","        ),\n","        \"Log loss\": log_loss(\n","            y_true,\n","            np.column_stack([1 - scores, scores]),\n","            labels=[0, 1]\n","        ),\n","        \"TP\": int(tp),\n","        \"TN\": int(tn),\n","        \"FP\": int(fp),\n","        \"FN\": int(fn)\n","    }\n","\n","\n","results = {}\n","split_scores = {}\n","\n","for split in [\"train\", \"valid\", \"test\"]:\n","    data = dataset[split]\n","    crack_column = list(best_model.classes_).index(1)\n","    scores = best_model.predict_proba(\n","        data[\"X\"]\n","    )[:, crack_column]\n","\n","    split_scores[split] = scores\n","    results[split] = evaluate(\n","        data[\"y\"], scores, best_threshold\n","    )\n","\n","    pd.DataFrame({\n","        \"image\": data[\"paths\"],\n","        \"actual_label\": data[\"y\"],\n","        \"crack_score\": scores,\n","        \"predicted_label\": (\n","            scores >= best_threshold\n","        ).astype(int)\n","    }).to_csv(\n","        RUN_DIR / f\"{split}_predictions.csv\",\n","        index=False\n","    )\n","\n","metrics_df = pd.DataFrame(results).T\n","metrics_df.index.name = \"split\"\n","metrics_df.to_csv(RUN_DIR / \"metrics.csv\")\n","\n","y_test = dataset[\"test\"][\"y\"]\n","test_scores = split_scores[\"test\"]\n","test_predictions = (\n","    test_scores >= best_threshold\n",").astype(int)\n","\n","class_report = pd.DataFrame(\n","    classification_report(\n","        y_test,\n","        test_predictions,\n","        labels=[0, 1],\n","        target_names=CLASS_NAMES,\n","        output_dict=True,\n","        zero_division=0\n","    )\n",").T\n","\n","class_report.to_csv(\n","    RUN_DIR / \"test_classification_report.csv\"\n",")\n","\n","print(\"\\nFinal test metrics:\")\n","print(metrics_df.loc[\"test\"])\n","\n","# Measure patch inference including image loading,\n","# resizing, HOG, scaling and classification.\n","timing_paths = dataset[\"test\"][\"paths\"][:100]\n","\n","# Warm up before measuring.\n","warm_features = extract_features(timing_paths[0])\n","best_model.predict_proba(warm_features.reshape(1, -1))\n","\n","start = time.perf_counter()\n","for path in timing_paths:\n","    features = extract_features(path)\n","    best_model.predict_proba(features.reshape(1, -1))\n","pipeline_ms = (\n","    (time.perf_counter() - start)\n","    / len(timing_paths) * 1000\n",")\n","\n","# ============================================================\n","# 6. GENERATE GRAPHS\n","# ============================================================\n","\n","def save_plot(name):\n","    path = PLOTS_DIR / name\n","    plt.tight_layout()\n","    plt.savefig(path, dpi=160, bbox_inches=\"tight\")\n","    plt.close()\n","    return path\n","\n","\n","plot_paths = []\n","\n","# Class distribution.\n","counts.plot.bar(figsize=(8, 4), color=[\"#35a98e\", \"#ef765d\"])\n","plt.title(\"Images in each dataset split\")\n","plt.ylabel(\"Number of images\")\n","plt.xticks(rotation=0)\n","plot_paths.append(save_plot(\"dataset_distribution.png\"))\n","\n","# Test confusion matrix.\n","cm = confusion_matrix(\n","    y_test, test_predictions, labels=[0, 1]\n",")\n","fig, ax = plt.subplots(figsize=(6, 5))\n","heatmap = ax.imshow(cm, cmap=\"Blues\")\n","\n","for i in range(2):\n","    for j in range(2):\n","        ax.text(\n","            j, i, str(cm[i, j]),\n","            ha=\"center\", va=\"center\", fontsize=18\n","        )\n","\n","ax.set_xticks([0, 1], CLASS_NAMES)\n","ax.set_yticks([0, 1], CLASS_NAMES)\n","ax.set_xlabel(\"Predicted\")\n","ax.set_ylabel(\"Actual\")\n","ax.set_title(\"Test confusion matrix\")\n","fig.colorbar(heatmap, ax=ax)\n","plot_paths.append(save_plot(\"test_confusion_matrix.png\"))\n","\n","# Test ROC.\n","fpr, tpr, _ = roc_curve(y_test, test_scores)\n","plt.figure(figsize=(7, 4))\n","plt.plot(\n","    fpr, tpr,\n","    label=f\"ROC AUC = {results['test']['ROC AUC']:.4f}\"\n",")\n","plt.plot([0, 1], [0, 1], \"--\", color=\"gray\")\n","plt.xlabel(\"False positive rate\")\n","plt.ylabel(\"True positive rate\")\n","plt.title(\"Test ROC curve\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","plot_paths.append(save_plot(\"test_roc.png\"))\n","\n","# Test precision-recall.\n","precision, recall, _ = precision_recall_curve(\n","    y_test, test_scores\n",")\n","plt.figure(figsize=(7, 4))\n","plt.plot(\n","    recall, precision,\n","    label=(\n","        \"Average precision = \"\n","        f\"{results['test']['Average precision (AP)']:.4f}\"\n","    )\n",")\n","plt.axhline(\n","    y_test.mean(), linestyle=\"--\",\n","    color=\"gray\", label=\"Positive-class prevalence\"\n",")\n","plt.xlabel(\"Crack recall\")\n","plt.ylabel(\"Crack precision\")\n","plt.title(\"Test precision-recall curve\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","plot_paths.append(save_plot(\"test_precision_recall.png\"))\n","\n","# Validation threshold selection.\n","valid_f1 = [\n","    f1_score(\n","        y_valid,\n","        (split_scores[\"valid\"] >= t).astype(int),\n","        zero_division=0\n","    )\n","    for t in THRESHOLDS\n","]\n","plt.figure(figsize=(7, 4))\n","plt.plot(THRESHOLDS, valid_f1)\n","plt.axvline(\n","    best_threshold,\n","    color=\"red\", linestyle=\"--\",\n","    label=f\"Selected threshold = {best_threshold:.2f}\"\n",")\n","plt.xlabel(\"Decision threshold\")\n","plt.ylabel(\"Validation crack F1\")\n","plt.title(\"Threshold chosen using validation only\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","plot_paths.append(save_plot(\"validation_threshold.png\"))\n","\n","# Test performance bars.\n","bar_metrics = [\n","    \"Accuracy\", \"Balanced accuracy\",\n","    \"Crack precision\", \"Crack recall\", \"Crack F1\"\n","]\n","plt.figure(figsize=(8, 4))\n","plt.bar(\n","    bar_metrics,\n","    [results[\"test\"][key] for key in bar_metrics],\n","    color=\"#337fa3\"\n",")\n","plt.ylim(0, 1.05)\n","plt.ylabel(\"Score\")\n","plt.title(\"Test performance\")\n","plt.xticks(rotation=20)\n","plot_paths.append(save_plot(\"test_metrics.png\"))\n","\n","# Example image and corresponding HOG visualization.\n","example_path = dataset[\"train\"][\"paths\"][0]\n","example_image = preprocess_image(example_path)\n","_, hog_image = hog(\n","    example_image,\n","    **{**HOG_SETTINGS, \"visualize\": True}\n",")\n","\n","fig, axes = plt.subplots(1, 2, figsize=(8, 4))\n","axes[0].imshow(example_image, cmap=\"gray\")\n","axes[0].set_title(\"Preprocessed training patch\")\n","axes[1].imshow(hog_image, cmap=\"gray\")\n","axes[1].set_title(\"HOG visualization\")\n","for ax in axes:\n","    ax.axis(\"off\")\n","plot_paths.append(save_plot(\"hog_example.png\"))\n","\n","# ============================================================\n","# 7. BUILD PDF REPORT\n","# ============================================================\n","\n","PDF_PATH = RUN_DIR / \"HOG_Logistic_Regression_Report.pdf\"\n","styles = getSampleStyleSheet()\n","story = []\n","\n","def paragraph(text, style=\"BodyText\"):\n","    story.append(Paragraph(escape(str(text)), styles[style]))\n","    story.append(Spacer(1, 8))\n","\n","\n","def add_table(headers, rows):\n","    table = Table(\n","        [headers] + rows,\n","        repeatRows=1,\n","        hAlign=\"LEFT\"\n","    )\n","    table.setStyle(TableStyle([\n","        (\"BACKGROUND\", (0, 0), (-1, 0), colors.HexColor(\"#172238\")),\n","        (\"TEXTCOLOR\", (0, 0), (-1, 0), colors.white),\n","        (\"FONTNAME\", (0, 0), (-1, 0), \"Helvetica-Bold\"),\n","        (\"FONTSIZE\", (0, 0), (-1, -1), 9),\n","        (\"TOPPADDING\", (0, 0), (-1, -1), 7),\n","        (\"BOTTOMPADDING\", (0, 0), (-1, -1), 7),\n","        (\"GRID\", (0, 0), (-1, -1), 0.4, colors.lightgrey),\n","        (\"ROWBACKGROUNDS\", (0, 1), (-1, -1),\n","         [colors.whitesmoke, colors.white])\n","    ]))\n","    story.append(table)\n","    story.append(Spacer(1, 14))\n","\n","\n","paragraph(\"HOG + Logistic Regression\", \"Title\")\n","paragraph(\"Bottle crack patch classification report\", \"Heading2\")\n","paragraph(f\"Run: {RUN_NAME}\")\n","paragraph(\"Labels: good = 0; crack = 1.\")\n","paragraph(\n","    \"Existing train/valid/test assignments were retained. \"\n","    \"Exact duplicate image pixels across splits were checked. \"\n","    \"This check cannot verify physical-bottle separation; \"\n","    \"that must already be correct in your folders.\"\n",")\n","\n","add_table(\n","    [\"Split\", \"Good images\", \"Crack images\"],\n","    [\n","        [\n","            split,\n","            str(int(counts.loc[split, \"good\"])),\n","            str(int(counts.loc[split, \"crack\"]))\n","        ]\n","        for split in [\"train\", \"valid\", \"test\"]\n","    ]\n",")\n","\n","paragraph(\"Model and selection procedure\", \"Heading2\")\n","paragraph(f\"Image resize: {IMAGE_SIZE}; grayscale input.\")\n","paragraph(f\"HOG settings: {HOG_SETTINGS}\")\n","paragraph(\n","    f\"HOG feature count: {X_train.shape[1]}. \"\n","    \"StandardScaler was fitted on training features only.\"\n",")\n","paragraph(\n","    f\"Selected C: {best_settings['C']}; \"\n","    f\"class weight: {best_settings['class_weight']}; \"\n","    f\"decision threshold: {best_threshold:.2f}.\"\n",")\n","paragraph(\n","    \"C, class weighting and threshold were selected using \"\n","    \"validation crack F1. The chosen model remains fitted \"\n","    \"on train only. Test data were not used for selection.\"\n",")\n","paragraph(\n","    \"Training scores are resubstitution scores. Validation \"\n","    \"scores are selection scores. Test scores provide the \"\n","    \"held-out evaluation.\"\n",")\n","\n","story.append(PageBreak())\n","paragraph(\"Train / validation / test metrics\", \"Heading1\")\n","\n","score_metrics = [\n","    \"Accuracy\", \"Balanced accuracy\",\n","    \"Crack precision\", \"Crack recall\",\n","    \"Crack F1\", \"Specificity\",\n","   
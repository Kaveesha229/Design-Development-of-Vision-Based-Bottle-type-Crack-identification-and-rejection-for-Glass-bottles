from torch import nn\n","from torch.utils.data import Dataset, DataLoader\n","import torchvision\n","from torchvision import transforms\n","from torchvision.models import resnet18, ResNet18_Weights\n","\n","from sklearn.metrics import (\n","    accuracy_score, balanced_accuracy_score,\n","    precision_score, recall_score, f1_score,\n","    confusion_matrix, classification_report,\n","    roc_auc_score, average_precision_score,\n","    roc_curve, precision_recall_curve, log_loss\n",")\n","\n","from reportlab.lib import colors\n","from reportlab.lib.styles import getSampleStyleSheet\n","from reportlab.lib.units import inch\n","from reportlab.platypus import (\n","    SimpleDocTemplate, Paragraph, Spacer, Table,\n","    TableStyle, Image as PDFImage, PageBreak\n",")\n","\n","from google.colab import drive, files\n","\n","# ============================================================\n","# 1. SETTINGS\n","# ============================================================\n","\n","DATASET_ROOT = Path(\"/content/drive/MyDrive/bottlecrackml\")\n","OUTPUT_ROOT = DATASET_ROOT / \"resnet18\"\n","\n","RUN_NAME = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","RUN_DIR = OUTPUT_ROOT / RUN_NAME\n","PLOTS_DIR = RUN_DIR / \"graphs\"\n","\n","CLASS_LABELS = {\"good\": 0, \"crack\": 1}\n","CLASS_NAMES = [\"good\", \"crack\"]\n","\n","IMAGE_SIZE = 224\n","BATCH_SIZE = 16\n","MAX_EPOCHS = 100\n","PATIENCE = 15\n","MIN_DELTA = 0.0001\n","LEARNING_RATE = 0.0001\n","WEIGHT_DECAY = 0.0001\n","RANDOM_SEED = 42\n","\n","# Zero workers is reliable in Colab and avoids worker errors.\n","NUM_WORKERS = 0\n","DEVICE = torch.device(\n","    \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",")\n","\n","THRESHOLDS = np.linspace(0.10, 0.90, 81)\n","EXTENSIONS = {\n","    \".jpg\", \".jpeg\", \".png\", \".bmp\",\n","    \".tif\", \".tiff\", \".webp\"\n","}\n","\n","random.seed(RANDOM_SEED)\n","np.random.seed(RANDOM_SEED)\n","torch.manual_seed(RANDOM_SEED)\n","\n","if torch.cuda.is_available():\n","    torch.cuda.manual_seed_all(RANDOM_SEED)\n","\n","torch.backends.cudnn.benchmark = False\n","torch.backends.cudnn.deterministic = True\n","\n","# ============================================================\n","# 2. MOUNT DRIVE AND CHECK DATA\n","# ============================================================\n","\n","if not Path(\"/content/drive/MyDrive\").exists():\n","    drive.mount(\"/content/drive\")\n","\n","PLOTS_DIR.mkdir(parents=True, exist_ok=True)\n","\n","print(\"Device:\", DEVICE)\n","if torch.cuda.is_available():\n","    print(\"GPU:\", torch.cuda.get_device_name(0))\n","else:\n","    print(\"CPU training may be slow. Enable a GPU runtime.\")\n","\n","def content_hash(path):\n","    with Image.open(path) as opened:\n","        image = ImageOps.exif_transpose(opened).convert(\"RGB\")\n","        hasher = hashlib.sha256()\n","        hasher.update(str(image.size).encode())\n","        hasher.update(image.tobytes())\n","        return hasher.hexdigest()\n","\n","\n","samples = {}\n","manifest = []\n","seen_hashes = {}\n","\n","for split in [\"train\", \"valid\", \"test\"]:\n","    samples[split] = []\n","\n","    for class_name, label in CLASS_LABELS.items():\n","        folder = DATASET_ROOT / split / class_name\n","\n","        if not folder.is_dir():\n","            raise FileNotFoundError(\n","                f\"Required folder missing:\\n{folder}\\n\"\n","                \"Check spelling and capitalization.\"\n","            )\n","\n","        paths = sorted(\n","            p for p in folder.rglob(\"*\")\n","            if p.is_file() and p.suffix.lower() in EXTENSIONS\n","        )\n","\n","        if not paths:\n","            raise ValueError(f\"No images found in:\\n{folder}\")\n","\n","        print(f\"Checking {split}/{class_name}: {len(paths)} images\")\n","\n","        for path in paths:\n","            try:\n","                digest = content_hash(path)\n","            except Exception as error:\n","                raise RuntimeError(\n","                    f\"Cannot read image:\\n{path}\\n{error}\"\n","                ) from error\n","\n","            if digest in seen_hashes:\n","                previous = seen_hashes[digest]\n","\n","                if previous[\"label\"] != label:\n","                    raise ValueError(\n","                        \"Identical image has conflicting labels:\\n\"\n","                        f\"{previous['path']}\\n{path}\"\n","                    )\n","\n","                if previous[\"split\"] != split:\n","                    raise ValueError(\n","                        \"Identical image occurs across dataset splits:\\n\"\n","                        f\"{previous['path']}\\n{path}\\n\"\n","                        \"Remove this leakage before training.\"\n","                    )\n","            else:\n","                seen_hashes[digest] = {\n","                    \"split\": split,\n","                    \"label\": label,\n","                    \"path\": str(path)\n","                }\n","\n","            samples[split].append((str(path), label))\n","            manifest.append({\n","                \"split\": split,\n","                \"class\": class_name,\n","                \"label\": label,\n","                \"path\": str(path),\n","                \"sha256\": digest\n","            })\n","\n","manifest_df = pd.DataFrame(manifest)\n","manifest_df.to_csv(\n","    RUN_DIR / \"dataset_manifest.csv\", index=False\n",")\n","\n","counts = pd.crosstab(\n","    manifest_df[\"split\"], manifest_df[\"class\"]\n",").reindex([\"train\", \"valid\", \"test\"])\n","\n","print(\"\\nDataset counts:\")\n","print(counts)\n","\n","# ============================================================\n","# 3. DATASETS AND TRANSFORMS\n","# ============================================================\n","\n","MEAN = [0.485, 0.456, 0.406]\n","STD = [0.229, 0.224, 0.225]\n","\n","# Resize the complete patch; do not center-crop away a crack.\n","# Only training receives augmentation.\n","train_transform = transforms.Compose([\n","    transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)),\n","    transforms.RandomHorizontalFlip(p=0.5),\n","    transforms.ToTensor(),\n","    transforms.Normalize(MEAN, STD)\n","])\n","\n","eval_transform = transforms.Compose([\n","    transforms.Resize((IMAGE_SIZE, IMAGE_SIZE)),\n","    transforms.ToTensor(),\n","    transforms.Normalize(MEAN, STD)\n","])\n","\n","\n","class BottleDataset(Dataset):\n","    def __init__(self, records, transform):\n","        self.records = records\n","        self.transform = transform\n","\n","    def __len__(self):\n","        return len(self.records)\n","\n","    def __getitem__(self, index):\n","        path, label = self.records[index]\n","        with Image.open(path) as opened:\n","            image = ImageOps.exif_transpose(opened).convert(\"RGB\")\n","        return self.transform(image), label\n","\n","\n","train_dataset = BottleDataset(\n","    samples[\"train\"], train_transform\n",")\n","\n","# Training batches are shuffled reproducibly.\n","generator = torch.Generator().manual_seed(RANDOM_SEED)\n","\n","train_loader = DataLoader(\n","    train_dataset,\n","    batch_size=BATCH_SIZE,\n","    shuffle=True,\n","    num_workers=NUM_WORKERS,\n","    pin_memory=DEVICE.type == \"cuda\",\n","    generator=generator\n",")\n","\n","# Evaluation loaders use no augmentation and no shuffling.\n","eval_loaders = {\n","    split: DataLoader(\n","        BottleDataset(samples[split], eval_transform),\n","        batch_size=BATCH_SIZE,\n","        shuffle=False,\n","        num_workers=NUM_WORKERS,\n","        pin_memory=DEVICE.type == \"cuda\"\n","    )\n","    for split in [\"train\", \"valid\", \"test\"]\n","}\n","\n","# ============================================================\n","# 4. MODEL, LOSS AND OPTIMIZER\n","# ============================================================\n","\n","model = resnet18(weights=ResNet18_Weights.DEFAULT)\n","model.fc = nn.Linear(model.fc.in_features, 2)\n","model = model.to(DEVICE)\n","\n","# Fine-tune all layers.\n","optimizer = torch.optim.AdamW(\n","    model.parameters(),\n","    lr=LEARNING_RATE,\n","    weight_decay=WEIGHT_DECAY\n",")\n","\n","# Unweighted loss; both classes must be present.\n","criterion = nn.CrossEntropyLoss()\n","\n","BEST_PATH = RUN_DIR / \"resnet18_best_weights.pth\"\n","LAST_PATH = RUN_DIR / \"resnet18_last_weights.pth\"\n","\n","def synchronize_device():\n","    if DEVICE.type == \"cuda\":\n","        torch.cuda.synchronize()\n","\n","# ============================================================\n","# 5. TRAIN WITH EARLY STOPPING\n","# ============================================================\n","\n","history_rows = []\n","best_loss = float(\"inf\")\n","best_epoch = 0\n","patience_reference = float(\"inf\")\n","epochs_without_improvement = 0\n","\n","training_start = time.perf_counter()\n","\n","for epoch in range(1, MAX_EPOCHS + 1):\n","    model.train()\n","    train_loss_sum = 0.0\n","    train_correct = 0\n","    train_count = 0\n","\n","    for images, labels in train_loader:\n","        images = images.to(DEVICE)\n","        labels = labels.to(DEVICE)\n","\n","        optimizer.zero_grad(set_to_none=True)\n","        logits = model(images)\n","        loss = criterion(logits, labels)\n","        loss.backward()\n","        optimizer.step()\n","\n","        train_loss_sum += loss.item() * len(labels)\n","        train_correct += (\n","            logits.argmax(dim=1) == labels\n","        ).sum().item()\n","        train_count += len(labels)\n","\n","    model.eval()\n","    valid_loss_sum = 0.0\n","    valid_labels = []\n","    valid_scores = []\n","\n","    with torch.inference_mode():\n","        for images, labels in eval_loaders[\"valid\"]:\n","            images = images.to(DEVICE)\n","            labels = labels.to(DEVICE)\n","\n","            logits = model(images)\n","            loss = criterion(logits, labels)\n","\n","            valid_loss_sum += loss.item() * len(labels)\n","            valid_labels.extend(labels.cpu().numpy().tolist())\n","            valid_scores.extend(\n","                torch.softmax(logits, dim=1)[:, 1]\n","                .cpu().numpy().tolist()\n","            )\n","\n","    train_loss = train_loss_sum / train_count\n","    train_accuracy = train_correct / train_count\n","    valid_loss = valid_loss_sum / len(samples[\"valid\"])\n","\n","    valid_labels = np.asarray(valid_labels)\n","    valid_scores = np.asarray(valid_scores)\n","    valid_predictions = (valid_scores >= 0.5).astype(int)\n","\n","    row = {\n","        \"epoch\": epoch,\n","        \"train_loss\": train_loss,\n","        \"train_accuracy\": train_accuracy,\n","        \"valid_loss\": valid_loss,\n","        \"valid_accuracy\": accuracy_score(\n","            valid_labels, valid_predictions\n","        ),\n","        \"valid_f1_at_0.5\": f1_score(\n","            valid_labels, valid_predictions, zero_division=0\n","        ),\n","        \"valid_average_precision\": average_precision_score(\n","            valid_labels, valid_scores\n","        )\n","    }\n","\n","    history_rows.append(row)\n","    pd.DataFrame(history_rows).to_csv(\n","        RUN_DIR / \"training_history.csv\", index=False\n","    )\n","\n","    # Save the actual lowest-loss model.\n","    if valid_loss < best_loss:\n","        best_loss = valid_loss\n","        best_epoch = epoch\n","        torch.save(\n","            {\n","                key: value.detach().cpu()\n","                for key, value in model.state_dict().items()\n","            },\n","            BEST_PATH\n","        )\n","\n","    # Patience requires an improvement larger than MIN_DELTA.\n","    if valid_loss < patience_reference - MIN_DELTA:\n","        patience_reference = valid_loss\n","        epochs_without_improvement = 0\n","    else:\n","        epochs_without_improvement += 1\n","\n","    print(\n","        f\"Epoch {epoch:03d}/{MAX_EPOCHS} | \"\n","        f\"train loss={train_loss:.4f} | \"\n","        f\"valid loss={valid_loss:.4f} | \"\n","        f\"valid F1@0.5={row['valid_f1_at_0.5']:.4f} | \"\n","        f\"patience={epochs_without_improvement}/{PATIENCE}\"\n","    )\n","\n","    if epochs_without_improvement >= PATIENCE:\n","        print(\"\\nEarly stopping triggered.\")\n","        break\n","\n","synchronize_device()\n","training_seconds = time.perf_counter() - training_start\n","\n","torch.save(\n","    {\n","        key: value.detach().cpu()\n","        for key, value in model.state_dict().items()\n","    },\n","    LAST_PATH\n",")\n","\n","# Evaluate only the selected best checkpoint.\n","model.load_state_dict(\n","    torch.load(BEST_PATH, map_location=DEVICE, weights_only=True)\n",")\n","model.eval()\n","\n","history = pd.DataFrame(history_rows)\n","\n","# ============================================================\n","# 6. SELECT THRESHOLD USING VALIDATION ONLY\n","# ============================================================\n","\n","def predict_loader(loader):\n","    labels_out = []\n","    scores_out = []\n","\n","    model.eval()\n","    with torch.inference_mode():\n","        for images, labels in loader:\n","            logits = model(images.to(DEVICE))\n","            scores = torch.softmax(logits, dim=1)[:, 1]\n","\n","            labels_out.extend(labels.numpy().tolist())\n","            scores_out.extend(scores.cpu().numpy().tolist())\n","\n","    return np.asarray(labels_out), np.asarray(scores_out)\n","\n","\n","y_valid, validation_scores = predict_loader(\n","    eval_loaders[\"valid\"]\n",")\n","\n","threshold_rows = []\n","for threshold in THRESHOLDS:\n","    predicted = (validation_scores >= threshold).astype(int)\n","    threshold_rows.append({\n","        \"threshold\": float(threshold),\n","        \"f1\": f1_score(y_valid, predicted, zero_division=0),\n","        \"recall\": recall_score(y_valid, predicted, zero_division=0),\n","        \"precision\": precision_score(\n","            y_valid, predicted, zero_division=0\n","        )\n","    })\n","\n","selected_threshold = max(\n","    threshold_rows,\n","    key=lambda row: (\n","        row[\"f1\"],\n","        row[\"recall\"],\n","        row[\"precision\"],\n","        -abs(row[\"threshold\"] - 0.5)\n","    )\n",")\n","threshold = selected_threshold[\"threshold\"]\n","\n","pd.DataFrame(threshold_rows).to_csv(\n","    RUN_DIR / \"validation_threshold_search.csv\", index=False\n",")\n","\n","configuration = {\n","    \"architecture\": \"resnet18\",\n","    \"num_classes\": 2,\n","    \"class_labels\": CLASS_LABELS,\n","    \"image_size\": IMAGE_SIZE,\n","    \"mean\": MEAN,\n","    \"std\": STD,\n","    \"preprocessing\": (\n","        \"EXIF correction, RGB, resize complete patch \"\n","        \"to 224x224, bilinear interpolation, tensor, normalization\"\n","    ),\n","    \"training_augmentation\": \"RandomHorizontalFlip(p=0.5)\",\n","    \"threshold\": threshold,\n","    \"best_epoch\": best_epoch,\n","    \"best_validation_loss\": best_loss,\n","    \"completed_epochs\": len(history),\n","    \"learning_rate\": LEARNING_RATE,\n","    \"weight_decay\": WEIGHT_DECAY,\n","    \"batch_size\": BATCH_SIZE,\n","    \"seed\": RANDOM_SEED,\n","    \"torch_version\": str(torch.__version__),\n","    \"torchvision_version\": str(torchvision.__version__)\n","}\n","\n","with open(RUN_DIR / \"configuration.json\", \"w\") as f:\n","    json.dump(configuration, f, indent=2)\n","\n","# Model package includes weights and inference settings.\n","MODEL_PATH = RUN_DIR / \"resnet18_model.pth\"\n","torch.save({\n","    \"model_state_dict\": {\n","        key: value.detach().cpu()\n","        for key, value in model.state_dict().items()\n","    },\n","    \"configuration\": configuration\n","}, MODEL_PATH)\n","\n","print(\"\\nBest epoch:\", best_epoch)\n","print(\"Selected threshold:\", threshold)\n","\n","# ============================================================\n","# 7. FINAL METRICS\n","# ============================================================\n","\n","def evaluate(y_true, scores):\n","    predicted = (scores >= threshold).astype(int)\n","    tn, fp, fn, tp = confusion_matrix(\n","        y_true, predicted, labels=[0, 1]\n","    ).ravel()\n","\n","    return {\n","        \"Accuracy\": accuracy_score(y_true, predicted),\n","        \"Balanced accuracy\": balanced_accuracy_score(\n","            y_true, predicted\n","        ),\n","        \"Crack precision\": precision_score(\n","            y_true, predicted, zero_division=0\n","        ),\n","        \"Crack recall\": recall_score(\n","            y_true, predicted, zero_division=0\n","        ),\n","        \"Crack F1\": f1_score(\n","            y_true, predicted, zero_division=0\n","        ),\n","        \"Specificity\": tn / (tn + fp),\n","        \"ROC AUC\": roc_auc_score(y_true, scores),\n","        \"Average precision (AP)\": average_precision_score(\n","            y_true, scores\n","        ),\n","        \"Log loss\": log_loss(\n","            y_true,\n","            np.column_stack([1 - scores, scores]),\n","            labels=[0, 1]\n","        ),\n","        \"TP\": int(tp), \"TN\": int(tn),\n","        \"FP\": int(fp), \"FN\": int(fn)\n","    }\n","\n","\n","results = {}\n","predictions_by_split = {}\n","\n","for split in [\"train\", \"valid\", \"test\"]:\n","    if split == \"valid\":\n","        labels, scores = y_valid, validation_scores\n","    else:\n","        labels, scores = predict_loader(eval_loaders[split])\n","\n","    predictions_by_split[split] = (labels, scores)\n","    results[split] = evaluate(labels, scores)\n","\n","    pd.DataFrame({\n","        \"image\": [path for path, _ in samples[split]],\n","        \"actual_label\": labels,\n","        \"crack_score\": scores,\n","        \"predicted_label\": (scores >= threshold).astype(int)\n","    }).to_csv(\n","        RUN_DIR / f\"{split}_predictions.csv\", index=False\n","    )\n","\n","metrics_df = pd.DataFrame(results).T\n","metrics_df.index.name = \"split\"\n","metrics_df.to_csv(RUN_DIR / \"metrics.csv\")\n","\n","y_test, test_scores = predictions_by_split[\"test\"]\n","test_predictions = (test_scores >= threshold).astype(int)\n","\n","pd.DataFrame(\n","    classification_report(\n","        y_test, test_predictions,\n","        labels=[0, 1],\n","        target_names=CLASS_NAMES,\n","        output_dict=True,\n","        zero_division=0\n","    )\n",").T.to_csv(RUN_DIR / \"test_classification_report.csv\")\n","\n","print(\"\\nFinal test results:\")\n","print(metrics_df.loc[\"test\"])\n","\n","# End-to-end single-patch timing.\n","timing_paths = [path for path, _ in samples[\"test\"][:100]]\n","\n","def predict_one(path):\n","    with Image.open(path) as opened:\n","        image = ImageOps.exif_transpose(opened).convert(\"RGB\")\n","\n","    tensor = eval_transform(image).unsqueeze(0).to(DEVICE)\n","\n","    with torch.inference_mode():\n","        return torch.softmax(model(tensor), dim=1)[0, 1].item()\n","\n","\n","predict_one(timing_paths[0])\n","synchronize_device()\n","\n","start = time.perf_counter()\n","for path in timing_paths:\n","    predict_one(path)\n","synchronize_device()\n","\n","pipeline_ms = (\n","    (time.perf_counter() - start)\n","    / len(timing_paths) * 1000\n",")\n","\n","# ============================================================\n","# 8. GRAPHS\n","# ============================================================\n","\n","def save_plot(name):\n","    path = PLOTS_DIR / name\n","    plt.tight_layout()\n","    plt.savefig(path, dpi=160, bbox_inches=\"tight\")\n","    plt.close()\n","    return path\n","\n","\n","plot_paths = []\n","\n","counts.plot.bar(\n","    figsize=(8, 4), color=[\"#35a98e\", \"#ef765d\"]\n",")\n","plt.title(\"Images in each split\")\n","plt.ylabel(\"Image count\")\n","plt.xticks(rotation=0)\n","plot_paths.append(save_plot(\"dataset_distribution.png\"))\n","\n","plt.figure(figsize=(8, 4))\n","plt.plot(history[\"epoch\"], history[\"train_loss\"], label=\"Train\")\n","plt.plot(history[\"epoch\"], history[\"valid_loss\"], label=\"Valid\")\n","plt.axvline(best_epoch, linestyle=\"--\", color=\"gray\",\n","            label=f\"Best epoch: {best_epoch}\")\n","plt.xlabel(\"Epoch\")\n","plt.ylabel(\"Cross-entropy loss\")\n","plt.title(\"Training and validation loss\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","plot_paths.append(save_plot(\"training_loss.png\"))\n","\n","plt.figure(figsize=(8, 4))\n","plt.plot(\n","    history[\"epoch\"], history[\"train_accuracy\"],\n","    label=\"Train (augmented batches)\"\n",")\n","plt.plot(\n","    history[\"epoch\"], history[\"valid_accuracy\"],\n","    label=\"Valid at threshold 0.5\"\n",")\n","plt.xlabel(\"Epoch\")\n","plt.ylabel(\"Accuracy\")\n","plt.title(\"Accuracy during training\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","plot_paths.append(save_plot(\"training_accuracy.png\"))\n","\n","plt.figure(figsize=(8, 4))\n","plt.plot(\n","    history[\"epoch\"], history[\"valid_f1_at_0.5\"],\n","    label=\"Validation F1 at 0.5\"\n",")\n","plt.plot(\n","    history[\"epoch\"], history[\"valid_average_precision\"],\n","    label=\"Validation average precision\"\n",")\n","plt.xlabel(\"Epoch\")\n","plt.ylabel(\"Score\")\n","plt.title(\"Validation performance during training\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","plot_paths.append(save_plot(\"validation_history.png\"))\n","\n","cm = confusion_matrix(y_test, test_predictions, labels=[0, 1])\n","fig, ax = plt.subplots(figsize=(6, 5))\n","heatmap = ax.imshow(cm, cmap=\"Blues\")\n","for i in range(2):\n","    for j in range(2):\n","        ax.text(j, i, str(cm[i, j]),\n","                ha=\"center\", va=\"center\", fontsize=18)\n","ax.set_xticks([0, 1], CLASS_NAMES)\n","ax.set_yticks([0, 1], CLASS_NAMES)\n","ax.set_xlabel(\"Predicted\")\n","ax.set_ylabel(\"Actual\")\n","ax.set_title(\"Test confusion matrix\")\n","fig.colorbar(heatmap, ax=ax)\n","plot_paths.append(save_plot(\"test_confusion_matrix.png\"))\n","\n","fpr, tpr, _ 
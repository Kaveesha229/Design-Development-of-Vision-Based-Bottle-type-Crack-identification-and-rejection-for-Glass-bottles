{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"gpuType":"T4","authorship_tag":"ABX9TyO3xMAwT+JsPH1OYb+JjB8C"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"},"accelerator":"GPU"},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kLircAB2dFXi","executionInfo":{"status":"ok","timestamp":1791042608189,"user_tz":-330,"elapsed":23569,"user":{"displayName":"Kaveesha Gunawardena","userId":"06440496172812552380"}},"outputId":"e234bb46-cd93-494b-db2e-b213126e38f1"},"outputs":[{"output_type":"stream","name":"stdout","text":["Select Runtime → Restart session, then run Cell 2.\n"]}],"source":["import sys\n","import subprocess\n","\n","subprocess.check_call([\n","    sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n","    \"scikit-learn\", \"scikit-image\", \"Pillow\",\n","    \"pandas\", \"joblib\", \"reportlab\"\n","])\n","\n","subprocess.check_call([\n","    sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n","    \"--no-cache-dir\", \"--force-reinstall\", \"--no-deps\",\n","    \"matplotlib==3.10.0\"\n","])\n","\n","print(\"Select Runtime → Restart session, then run Cell 2.\")"]},{"cell_type":"code","source":["# ============================================================\n","# HOG + RANDOM FOREST — GOOGLE COLAB\n","# good = 0, crack = 1\n","# Uses existing train / valid / test folders.\n","# ============================================================\n","\n","from pathlib import Path\n","from datetime import datetime\n","from itertools import product\n","import hashlib\n","import json\n","import platform\n","import time\n","from xml.sax.saxutils import escape\n","\n","import numpy as np\n","import pandas as pd\n","import joblib\n","import sklearn\n","import skimage\n","\n","from PIL import Image, ImageOps\n","from skimage.feature import hog\n","\n","import matplotlib\n","matplotlib.use(\"Agg\")\n","import matplotlib.pyplot as plt\n","\n","from sklearn.ensemble import RandomForestClassifier\n","from sklearn.metrics import (\n","    accuracy_score, balanced_accuracy_score,\n","    precision_score, recall_score, f1_score,\n","    confusion_matrix, classification_report,\n","    roc_auc_score, average_precision_score,\n","    roc_curve, precision_recall_curve, log_loss\n",")\n","\n","from reportlab.lib import colors\n","from reportlab.lib.styles import getSampleStyleSheet\n","from reportlab.lib.units import inch\n","from reportlab.platypus import (\n","    SimpleDocTemplate, Paragraph, Spacer, Table,\n","    TableStyle, Image as PDFImage, PageBreak\n",")\n","\n","from google.colab import drive, files\n","\n","# ============================================================\n","# 1. SETTINGS\n","# ============================================================\n","\n","DATASET_ROOT = Path(\"/content/drive/MyDrive/bottlecrackml\")\n","OUTPUT_ROOT = DATASET_ROOT / \"hog + random forest\"\n","\n","RUN_NAME = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","RUN_DIR = OUTPUT_ROOT / RUN_NAME\n","PLOTS_DIR = RUN_DIR / \"graphs\"\n","\n","CLASS_LABELS = {\"good\": 0, \"crack\": 1}\n","CLASS_NAMES = [\"good\", \"crack\"]\n","RANDOM_SEED = 42\n","\n","# Same preprocessing as your Logistic Regression and SVM.\n","IMAGE_SIZE = (128, 128)\n","\n","HOG_SETTINGS = {\n","    \"orientations\": 9,\n","    \"pixels_per_cell\": (8, 8),\n","    \"cells_per_block\": (2, 2),\n","    \"block_norm\": \"L2-Hys\",\n","    \"transform_sqrt\": True,\n","    \"feature_vector\": True\n","}\n","\n","# Eight candidate configurations.\n","N_TREES = 200\n","MAX_DEPTH_VALUES = [None, 20]\n","MIN_LEAF_VALUES = [1, 3]\n","CLASS_WEIGHTS = [None, \"balanced\"]\n","THRESHOLDS = np.linspace(0.10, 0.90, 81)\n","\n","EXTENSIONS = {\n","    \".jpg\", \".jpeg\", \".png\", \".bmp\",\n","    \".tif\", \".tiff\", \".webp\"\n","}\n","\n","# ============================================================\n","# 2. DRIVE AND FOLDER CHECKS\n","# ============================================================\n","\n","if not Path(\"/content/drive/MyDrive\").exists():\n","    drive.mount(\"/content/drive\")\n","\n","for split in [\"train\", \"valid\", \"test\"]:\n","    for class_name in CLASS_LABELS:\n","        folder = DATASET_ROOT / split / class_name\n","        if not folder.is_dir():\n","            raise FileNotFoundError(\n","                f\"Required folder missing:\\n{folder}\\n\"\n","                \"Check spelling, capitalization and DATASET_ROOT.\"\n","            )\n","\n","PLOTS_DIR.mkdir(parents=True, exist_ok=True)\n","\n","print(\"Dataset:\", DATASET_ROOT)\n","print(\"Output:\", RUN_DIR)\n","print(\"Random Forest uses CPU; a GPU is not required.\")\n","\n","# ============================================================\n","# 3. IMAGE PREPROCESSING AND HOG\n","# ============================================================\n","\n","def preprocess_image(path):\n","    with Image.open(path) as opened:\n","        image = ImageOps.exif_transpose(opened).convert(\"L\")\n","        image = image.resize(\n","            IMAGE_SIZE, Image.Resampling.LANCZOS\n","        )\n","        return np.asarray(image, dtype=np.float32) / 255.0\n","\n","\n","def extract_features(path):\n","    return hog(\n","        preprocess_image(path), **HOG_SETTINGS\n","    ).astype(np.float32)\n","\n","\n","def content_hash(path):\n","    with Image.open(path) as opened:\n","        image = ImageOps.exif_transpose(opened).convert(\"RGB\")\n","        hasher = hashlib.sha256()\n","        hasher.update(str(image.size).encode())\n","        hasher.update(image.tobytes())\n","        return hasher.hexdigest()\n","\n","\n","dataset = {}\n","manifest = []\n","seen_hashes = {}\n","\n","for split in [\"train\", \"valid\", \"test\"]:\n","    feature_rows, labels, paths = [], [], []\n","\n","    for class_name, label in CLASS_LABELS.items():\n","        folder = DATASET_ROOT / split / class_name\n","        image_paths = sorted(\n","            p for p in folder.rglob(\"*\")\n","            if p.is_file() and p.suffix.lower() in EXTENSIONS\n","        )\n","\n","        if not image_paths:\n","            raise ValueError(f\"No images found in:\\n{folder}\")\n","\n","        print(\n","            f\"Loading {split}/{class_name}: \"\n","            f\"{len(image_paths)} images\"\n","        )\n","\n","        for path in image_paths:\n","            try:\n","                digest = content_hash(path)\n","\n","                if digest in seen_hashes:\n","                    previous = seen_hashes[digest]\n","\n","                    if previous[\"label\"] != label:\n","                        raise ValueError(\n","                            \"Identical image has conflicting labels:\\n\"\n","                            f\"{previous['path']}\\n{path}\"\n","                        )\n","\n","                    if previous[\"split\"] != split:\n","                        raise ValueError(\n","                            \"Identical image found across splits:\\n\"\n","                            f\"{previous['path']}\\n{path}\\n\"\n","                            \"Remove this leakage before training.\"\n","                        )\n","                else:\n","                    seen_hashes[digest] = {\n","                        \"split\": split,\n","                        \"label\": label,\n","                        \"path\": str(path)\n","                    }\n","\n","                features = extract_features(path)\n","\n","            except Exception as error:\n","                raise RuntimeError(\n","                    f\"Could not process:\\n{path}\\n{error}\"\n","                ) from error\n","\n","            feature_rows.append(features)\n","            labels.append(label)\n","            paths.append(str(path))\n","            manifest.append({\n","                \"split\": split,\n","                \"class\": class_name,\n","                \"label\": label,\n","                \"path\": str(path),\n","                \"sha256\": digest\n","            })\n","\n","    dataset[split] = {\n","        \"X\": np.stack(feature_rows),\n","        \"y\": np.asarray(labels, dtype=np.int64),\n","        \"paths\": paths\n","    }\n","\n","manifest_df = pd.DataFrame(manifest)\n","manifest_df.to_csv(\n","    RUN_DIR / \"dataset_manifest.csv\", index=False\n",")\n","\n","counts = pd.crosstab(\n","    manifest_df[\"split\"], manifest_df[\"class\"]\n",").reindex([\"train\", \"valid\", \"test\"])\n","\n","print(\"\\nDataset counts:\")\n","print(counts)\n","print(\"HOG features per image:\", dataset[\"train\"][\"X\"].shape[1])\n","\n","np.savez_compressed(\n","    RUN_DIR / \"hog_features.npz\",\n","    X_train=dataset[\"train\"][\"X\"],\n","    y_train=dataset[\"train\"][\"y\"],\n","    X_valid=dataset[\"valid\"][\"X\"],\n","    y_valid=dataset[\"valid\"][\"y\"],\n","    X_test=dataset[\"test\"][\"X\"],\n","    y_test=dataset[\"test\"][\"y\"]\n",")\n","\n","X_train = dataset[\"train\"][\"X\"]\n","y_train = dataset[\"train\"][\"y\"]\n","X_valid = dataset[\"valid\"][\"X\"]\n","y_valid = dataset[\"valid\"][\"y\"]\n","\n","# ============================================================\n","# 4. TRAIN AND SELECT USING VALIDATION ONLY\n","# ============================================================\n","\n","# Random Forest does not need StandardScaler.\n","# The underlying HOG features remain the same.\n","search_rows = []\n","best_model = None\n","best_key = None\n","best_threshold = None\n","best_settings = None\n","\n","search_start = time.perf_counter()\n","\n","for max_depth, min_leaf, class_weight in product(\n","    MAX_DEPTH_VALUES, MIN_LEAF_VALUES, CLASS_WEIGHTS\n","):\n","    settings = {\n","        \"n_estimators\": N_TREES,\n","        \"max_depth\": max_depth,\n","        \"min_samples_leaf\": min_leaf,\n","        \"max_features\": \"sqrt\",\n","        \"class_weight\": class_weight\n","    }\n","\n","    print(\"\\nTraining:\", settings)\n","\n","    model = RandomForestClassifier(\n","        **settings,\n","        random_state=RANDOM_SEED,\n","        n_jobs=-1\n","    )\n","\n","    start = time.perf_counter()\n","    model.fit(X_train, y_train)\n","    fit_seconds = time.perf_counter() - start\n","\n","    crack_column = list(model.classes_).index(1)\n","    valid_scores = model.predict_proba(\n","        X_valid\n","    )[:, crack_column]\n","\n","    threshold_rows = []\n","    for threshold in THRESHOLDS:\n","        predicted = (valid_scores >= threshold).astype(int)\n","        threshold_rows.append({\n","            \"threshold\": float(threshold),\n","            \"f1\": f1_score(\n","                y_valid, predicted, zero_division=0\n","            ),\n","            \"recall\": recall_score(\n","                y_valid, predicted, zero_division=0\n","            ),\n","            \"precision\": precision_score(\n","                y_valid, predicted, zero_division=0\n","            )\n","        })\n","\n","    selected = max(\n","        threshold_rows,\n","        key=lambda row: (\n","            row[\"f1\"],\n","            row[\"recall\"],\n","            row[\"precision\"],\n","            -abs(row[\"threshold\"] - 0.5)\n","        )\n","    )\n","\n","    search_rows.append({\n","        \"max_depth\": str(max_depth),\n","        \"min_samples_leaf\": min_leaf,\n","        \"class_weight\": str(class_weight),\n","        \"threshold\": selected[\"threshold\"],\n","        \"valid_f1\": selected[\"f1\"],\n","        \"valid_recall\": selected[\"recall\"],\n","        \"valid_precision\": selected[\"precision\"],\n","        \"fit_seconds\": fit_seconds\n","    })\n","\n","    print(\n","        f\"Validation F1={selected['f1']:.4f}, \"\n","        f\"recall={selected['recall']:.4f}\"\n","    )\n","\n","    key = (\n","        selected[\"f1\"],\n","        selected[\"recall\"],\n","        selected[\"precision\"]\n","    )\n","\n","    if best_key is None or key > best_key:\n","        best_key = key\n","        best_model = model\n","        best_threshold = selected[\"threshold\"]\n","        best_settings = settings.copy()\n","\n","search_seconds = time.perf_counter() - search_start\n","search_df = pd.DataFrame(search_rows)\n","search_df.to_csv(\n","    RUN_DIR / \"validation_search.csv\", index=False\n",")\n","\n","print(\"\\nSelected settings:\", best_settings)\n","print(\"Selected threshold:\", best_threshold)\n","\n","# Retain the selected model trained on TRAIN only.\n","MODEL_PATH = RUN_DIR / \"hog_random_forest.joblib\"\n","\n","configuration = {\n","    \"class_labels\": CLASS_LABELS,\n","    \"image_size\": IMAGE_SIZE,\n","    \"hog_settings\": HOG_SETTINGS,\n","    \"preprocessing\": (\n","        \"EXIF correction, grayscale, Lanczos resize \"\n","        \"to 128x128, float pixels divided by 255\"\n","    ),\n","    \"threshold\": best_threshold,\n","    \"selected_settings\": best_settings,\n","    \"random_seed\": RANDOM_SEED,\n","    \"sklearn_version\": sklearn.__version__,\n","    \"skimage_version\": skimage.__version__\n","}\n","\n","joblib.dump({\n","    \"classifier\": best_model,\n","    \"configuration\": configuration\n","}, MODEL_PATH)\n","\n","with open(RUN_DIR / \"configuration.json\", \"w\") as f:\n","    json.dump(configuration, f, indent=2)\n","\n","# ============================================================\n","# 5. FINAL EVALUATION\n","# ============================================================\n","\n","def evaluate(y_true, scores, threshold):\n","    predicted = (scores >= threshold).astype(int)\n","    tn, fp, fn, tp = confusion_matrix(\n","        y_true, predicted, labels=[0, 1]\n","    ).ravel()\n","\n","    return {\n","        \"Accuracy\": accuracy_score(y_true, predicted),\n","        \"Balanced accuracy\": balanced_accuracy_score(\n","            y_true, predicted\n","        ),\n","        \"Crack precision\": precision_score(\n","            y_true, predicted, zero_division=0\n","        ),\n","        \"Crack recall\": recall_score(\n","            y_true, predicted, zero_division=0\n","        ),\n","        \"Crack F1\": f1_score(\n","            y_true, predicted, zero_division=0\n","        ),\n","        \"Specificity\": tn / (tn + fp),\n","        \"ROC AUC\": roc_auc_score(y_true, scores),\n","        \"Average precision (AP)\": average_precision_score(\n","            y_true, scores\n","        ),\n","        \"Log loss\": log_loss(\n","            y_true,\n","            np.column_stack([1 - scores, scores]),\n","            labels=[0, 1]\n","        ),\n","        \"TP\": int(tp),\n","        \"TN\": int(tn),\n","        \"FP\": int(fp),\n","        \"FN\": int(fn)\n","    }\n","\n","\n","results = {}\n","split_scores = {}\n","crack_column = list(best_model.classes_).index(1)\n","\n","for split in [\"train\", \"valid\", \"test\"]:\n","    data = dataset[split]\n","    scores = best_model.predict_proba(\n","        data[\"X\"]\n","    )[:, crack_column]\n","\n","    split_scores[split] = scores\n","    results[split] = evaluate(\n","        data[\"y\"], scores, best_threshold\n","    )\n","\n","    pd.DataFrame({\n","        \"image\": data[\"paths\"],\n","        \"actual_label\": data[\"y\"],\n","        \"crack_score\": scores,\n","        \"predicted_label\": (\n","            scores >= best_threshold\n","        ).astype(int)\n","    }).to_csv(\n","        RUN_DIR / f\"{split}_predictions.csv\", index=False\n","    )\n","\n","metrics_df = pd.DataFrame(results).T\n","metrics_df.index.name = \"split\"\n","metrics_df.to_csv(RUN_DIR / \"metrics.csv\")\n","\n","y_test = dataset[\"test\"][\"y\"]\n","test_scores = split_scores[\"test\"]\n","test_predictions = (\n","    test_scores >= best_threshold\n",").astype(int)\n","\n","class_report = pd.DataFrame(\n","    classification_report(\n","        y_test, test_predictions,\n","        labels=[0, 1],\n","        target_names=CLASS_NAMES,\n","        output_dict=True,\n","        zero_division=0\n","    )\n",").T\n","class_report.to_csv(\n","    RUN_DIR / \"test_classification_report.csv\"\n",")\n","\n","print(\"\\nFinal test metrics:\")\n","print(metrics_df.loc[\"test\"])\n","\n","# Save HOG feature importances.\n","pd.DataFrame({\n","    \"hog_feature_index\": np.arange(X_train.shape[1]),\n","    \"importance\": best_model.feature_importances_\n","}).to_csv(\n","    RUN_DIR / \"feature_importances.csv\", index=False\n",")\n","\n","# Patch timing includes reading, preprocessing, HOG and prediction.\n","timing_paths = dataset[\"test\"][\"paths\"][:100]\n","\n","warm_features = extract_features(timing_paths[0])\n","best_model.predict_proba(warm_features.reshape(1, -1))\n","\n","start = time.perf_counter()\n","for path in timing_paths:\n","    features = extract_features(path)\n","    best_model.predict_proba(features.reshape(1, -1))\n","\n","pipeline_ms = (\n","    (time.perf_counter() - start)\n","    / len(timing_paths) * 1000\n",")\n","\n","# ============================================================\n","# 6. GRAPHS\n","# ============================================================\n","\n","def save_plot(name):\n","    path = PLOTS_DIR / name\n","    plt.tight_layout()\n","    plt.savefig(path, dpi=160, bbox_inches=\"tight\")\n","    plt.close()\n","    return path\n","\n","\n","plot_paths = []\n","\n","counts.plot.bar(\n","    figsize=(8, 4), color=[\"#35a98e\", \"#ef765d\"]\n",")\n","plt.title(\"Images in each dataset split\")\n","plt.ylabel(\"Number of images\")\n","plt.xticks(rotation=0)\n","plot_paths.append(save_plot(\"dataset_distribution.png\"))\n","\n","# Confusion matrix.\n","cm = confusion_matrix(\n","    y_test, test_predictions, labels=[0, 1]\n",")\n","fig, ax = plt.subplots(figsize=(6, 5))\n","heatmap = ax.imshow(cm, cmap=\"Blues\")\n","for i in range(2):\n","    for j in range(2):\n","        ax.text(\n","            j, i, str(cm[i, j]),\n","            ha=\"center\", va=\"center\", fontsize=18\n","        )\n","ax.set_xticks([0, 1], CLASS_NAMES)\n","ax.set_yticks([0, 1], CLASS_NAMES)\n","ax.set_xlabel(\"Predicted\")\n","ax.set_ylabel(\"Actual\")\n","ax.set_title(\"Test confusion matrix\")\n","fig.colorbar(heatmap, ax=ax)\n","plot_paths.append(save_plot(\"test_confusion_matrix.png\"))\n","\n","# ROC.\n","fpr, tpr, _ = roc_curve(y_test, test_scores)\n","plt.figure(figsize=(7, 4))\n","plt.plot(\n","    fpr, tpr,\n","    label=f\"ROC AUC = {results['test']['ROC AUC']:.4f}\"\n",")\n","plt.plot([0, 1], [0, 1], \"--\", color=\"gray\")\n","plt.xlabel(\"False positive rate\")\n","plt.ylabel(\"True positive rate\")\n","plt.title(\"Test ROC curve\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","plot_paths.append(save_plot(\"test_roc.png\"))\n","\n","# Precision-recall.\n","precision, recall, _ = precision_recall_curve(\n","    y_test, test_scores\n",")\n","plt.figure(figsize=(7, 4))\n","plt.plot(\n","    recall, precision,\n","    label=(\n","        \"Average precision = \"\n","        f\"{results['test']['Average precision (AP)']:.4f}\"\n","    )\n",")\n","plt.axhline(\n","    y_test.mean(), linestyle=\"--\",\n","    color=\"gray\", label=\"Positive-class prevalence\"\n",")\n","plt.xlabel(\"Crack recall\")\n","plt.ylabel(\"Crack precision\")\n","plt.title(\"Test precision-recall curve\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","plot_paths.append(save_plot(\"test_precision_recall.png\"))\n","\n","# Validation threshold.\n","validation_f1 = [\n","    f1_score(\n","        y_valid,\n","        (split_scores[\"valid\"] >= t).astype(int),\n","        zero_division=0\n","    )\n","    for t in THRESHOLDS\n","]\n","plt.figure(figsize=(7, 4))\n","plt.plot(THRESHOLDS, validation_f1)\n","plt.axvline(\n","    best_threshold, color=\"red\", linestyle=\"--\",\n","    label=f\"Selected threshold = {best_threshold:.2f}\"\n",")\n","plt.xlabel(\"Decision threshold\")\n","plt.ylabel(\"Validation crack F1\")\n","plt.title(\"Threshold selected using validation only\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","plot_paths.append(save_plot(\"validation_threshold.png\"))\n","\n","# Test performance.\n","bar_metrics = [\n","    \"Accuracy\", \"Balanced accuracy\",\n","    \"Crack precision\", \"Crack recall\", \"Crack F1\"\n","]\n","plt.figure(figsize=(8, 4))\n","plt.bar(\n","    bar_metrics,\n","    [results[\"test\"][key] for key in bar_metrics],\n","    color=\"#337fa3\"\n",")\n","plt.ylim(0, 1.05)\n","plt.ylabel(\"Score\")\n","plt.title(\"HOG + Random Forest — test performance\")\n","plt.xticks(rotation=20)\n","plot_paths.append(save_plot(\"test_metrics.png\"))\n","\n","# Validation candidate comparison.\n","candidate_labels = [\n","    f\"depth={row['max_depth']}, \"\n","    f\"leaf={row['min_samples_leaf']}, \"\n","    f\"weight={row['class_weight']}\"\n","    for row in search_rows\n","]\n","plt.figure(figsize=(10, 5))\n","plt.barh(\n","    candidate_labels,\n","    [row[\"valid_f1\"] for row in search_rows],\n","    color=\"#35a98e\"\n",")\n","plt.xlim(0, 1.05)\n","plt.xlabel(\"Validation crack F1\")\n","plt.title(\"Random Forest candidate comparison\")\n","plot_paths.append(save_plot(\"validation_search.png\"))\n","\n","# Feature importances: diagnostic, not a spatial crack map.\n","top_indices = np.argsort(\n","    best_model.feature_importances_\n",")[-20:]\n","plt.figure(figsize=(8, 5))\n","plt.barh(\n","    [str(i) for i in top_indices],\n","    best_model.feature_importances_[top_indices]\n",")\n","plt.xlabel(\"Impurity-based importance\")\n","plt.ylabel(\"HOG feature index\")\n","plt.title(\"Top 20 HOG feature importances\")\n","plot_paths.append(save_plot(\"feature_importances.png\"))\n","\n","# HOG example.\n","example_image = preprocess_image(\n","    dataset[\"train\"][\"paths\"][0]\n",")\n","_, hog_image = hog(\n","    example_image,\n","    **{**HOG_SETTINGS, \"visualize\": True}\n",")\n","fig, axes = plt.subplots(1, 2, figsize=(8, 4))\n","axes[0].imshow(example_image, cmap=\"gray\")\n","axes[0].set_title(\"Preprocessed training patch\")\n","axes[1].imshow(hog_image, cmap=\"gray\")\n","axes[1].set_title(\"HOG visualization\")\n","for ax in axes:\n","    ax.axis(\"off\")\n","plot_paths.append(save_plot(\"hog_example.png\"))\n","\n","# ============================================================\n","# 7. PDF REPORT\n","# ============================================================\n","\n","PDF_PATH = RUN_DIR / \"HOG_Random_Forest_Report.pdf\"\n","styles = getSampleStyleSheet()\n","story = []\n","\n","def paragraph(text, style=\"BodyText\"):\n","    story.append(\n","        Paragraph(escape(str(text)), styles[style])\n","    )\n","    story.append(Spacer(1, 8))\n","\n","\n","def add_table(headers, rows):\n","    table = Table(\n","        [headers] + rows,\n","        repeatRows=1,\n","        hAlign=\"LEFT\"\n","    )\n","    table.setStyle(TableStyle([\n","        (\"BACKGROUND\", (0, 0), (-1, 0),\n","         colors.HexColor(\"#172238\")),\n","        (\"TEXTCOLOR\", (0, 0), (-1, 0), colors.white),\n","        (\"FONTNAME\", (0, 0), (-1, 0), \"Helvetica-Bold\"),\n","        (\"FONTSIZE\", (0, 0), (-1, -1), 9),\n","        (\"TOPPADDING\", (0, 0), (-1, -1), 7),\n","        (\"BOTTOMPADDING\", (0, 0), (-1, -1), 7),\n","        (\"GRID\", (0, 0), (-1, -1), 0.4, colors.lightgrey),\n","        (\"ROWBACKGROUNDS\", (0, 1), (-1, -1),\n","         [colors.whitesmoke, colors.white])\n","    ]))\n","    story.append(table)\n","    story.append(Spacer(1, 14))\n","\n","\n","paragraph(\"HOG + Random Forest\", \"Title\")\n","paragraph(\"Bottle crack patch classification report\", \"Heading2\")\n","paragraph(f\"Run: {RUN_NAME}\")\n","paragraph(\"Labels: good = 0; crack = 1.\")\n","paragraph(\n","    \"Existing splits were retained. Exact duplicate image \"\n","    \"pixels across splits were checked. Physical-bottle \"\n","    \"separation must already be correct in the folders.\"\n",")\n","\n","add_table(\n","    [\"Split\", \"Good images\", \"Crack images\"],\n","    [\n","        [\n","            split,\n","            str(int(counts.lo